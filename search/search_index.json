{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"\u2190 \u8fd4\u56de <p>\u4eb2\u7231\u7684\u670b\u53cb\uff1a</p> <p>\u5199\u4e0b\u8fd9\u6bb5\u8bdd\u7684\u65f6\u5019\uff0c\u6211\u60f3\u8d77\u7684\u5168\u662f\u90a3\u4e9b\u5728\u4e00\u8d77\u7684\u65e5\u5b50\u3002</p> <p>\u4e5f\u8bb8\u6211\u4eec\u5f88\u4e45\u6ca1\u6709\u89c1\u9762\uff0c\u4e5f\u8bb8\u6211\u4eec\u5404\u81ea\u5728\u5fd9\u5404\u81ea\u7684\u751f\u6d3b\uff0c\u4f46\u53ea\u8981\u7ffb\u5f00\u76f8\u518c\uff0c\u4e00\u5207\u5c31\u597d\u50cf\u8fd8\u5728\u6628\u5929\u3002</p> <p>\u611f\u8c22\u4f60\u7684\u966a\u4f34\u3002\u65e0\u8bba\u8d70\u5f97\u591a\u8fdc\uff0c\u8fd9\u91cc\u6c38\u8fdc\u6709\u4e00\u9875\u5c5e\u4e8e\u4f60\u3002</p> <p>\u613f\u4f60\u5c81\u5c81\u5e38\u6b22\u6109\uff0c\u4e07\u4e8b\u7686\u80dc\u610f\uff1b\u613f\u6240\u6709\u7f8e\u597d\uff0c\u90fd\u5982\u671f\u800c\u81f3\u3002</p> <p>\u2014\u2014 2026.8.15</p>"},{"location":"#home-title","title":"\u751f\u65e5\u5feb\u4e50","text":"<p>\u5c81\u5c81\u5e38\u6b22\u6109\uff0c\u4e07\u4e8b\u7686\u80dc\u610f</p> <p>\u613f\u6240\u6709\u7f8e\u597d\u90fd\u5982\u671f\u800c\u81f3</p> \u67e5\u770b\u5bc4\u8bed"}]}